# Your school's Canvas host (required), e.g. https://canvas.yourschool.edu
CANVAS_BASE_URL=
# Canvas personal access token: Canvas -> Account -> Settings -> New Access Token
CANVAS_TOKEN=
# Optional overrides
CANVAS_DOWNLOAD_DIR=~/Canvas
# CANVAS_AUTH=gateway   -> no token here; an outbound proxy injects the Authorization
#                          header and this process sends none.
# CANVAS_READ_ONLY=1    -> submit_assignment_file is never registered (read-only deployment).
